#!/usr/bin/env bash
# omarchy:summary=Install the OmaKeys daemon (from the latest GitHub release or a local build) and grant input-group access (no re-login)
# omarchy:requires-sudo=true

set -euo pipefail

if (( EUID == 0 )); then
  export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
DAEMON="$SCRIPT_DIR/omakeys-daemon"
REPO="skvggor/omakeys-omarchy-plugin"
RELEASES_URL="https://github.com/$REPO/releases/download"
ATTESTATIONS_API="https://api.github.com/repos/$REPO/attestations"
HELPER_ASSET="omakeys-daemon-x86_64-linux-gnu"
PINNED_VERSION="v1.0.0"
PINNED_SHA256="5aa5484fb7c556f2461177286040c0200a708c84e965382184f97eafef885f8b"
PINNED_COMMIT="e252db81ff26b7f58376897369e2f62306838258"
asset_dir=""

fail() {
  echo "error: $*" >&2
  exit 1
}

cleanup() {
  [[ -n "$asset_dir" ]] && rm -rf "$asset_dir"
}

trap cleanup EXIT

usage() {
  echo "Usage: $(basename "$0") [--check|--build|--build-install|--install|--uninstall|--usermod]" >&2
  echo "  --check          Report daemon readiness and setgid status" >&2
  echo "  --build          Compile the daemon locally with cargo (developers only, no sudo)" >&2
  echo "  --build-install  Compile locally and setgid it to group 'input' (developers, sudo)" >&2
  echo "  --install        Download the daemon from the latest GitHub release and setgid it (sudo, no Rust needed)" >&2
  echo "  --uninstall      Remove the setgid daemon binary (sudo)" >&2
  echo "  --usermod        Install from release and add the current user to the 'input' group (next login)" >&2
  echo "  -h, --help       Show this help" >&2
  echo "Environment:" >&2
  echo "  OMAKEYS_VERSION  Release tag to download, e.g. v1.0.0 (default: reads manifest.json)" >&2
  # omarchy:flag-requires-sudo=true
  exit 1
}

run_as_root() {
  local command_name="$1"
  shift
  if (( EUID == 0 )); then
    "$command_name" "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo "$command_name" "$@"
  elif command -v pkexec >/dev/null 2>&1; then
    pkexec "$command_name" "$@"
  else
    fail "need root (no sudo or pkexec available): $command_name $*"
  fi
}

resolve_version() {
  local version="${OMAKEYS_VERSION:-}"
  if [[ -z "$version" ]]; then
    if command -v jq >/dev/null 2>&1 && [[ -f "$PROJECT_DIR/manifest.json" ]]; then
      local parsed_version
      parsed_version="$(jq -r '.version // empty' "$PROJECT_DIR/manifest.json")"
      if [[ -n "$parsed_version" && "$parsed_version" != "null" ]]; then
        version="v$parsed_version"
      fi
    fi
  fi

  if [[ -z "$version" ]]; then
    version="$(curl --fail --silent --show-error --connect-timeout 10 \
      --max-time 20 --head \
      "https://github.com/$REPO/releases/latest" \
      | grep -i '^location:' \
      | sed -n 's/.*\/tag\/\(v[0-9a-zA-Z.-]*\).*/\1/p' \
      | tr -d '\r' \
      | head -n 1 || true)"
  fi

  [[ -n "$version" ]] || fail "could not resolve version (set OMAKEYS_VERSION or install jq)"
  echo "$version"
}

verify_attestation() {
  local binary_path="$1"
  local binary_sha256="$2"
  local expected_commit="${3:-}"
  local version="${4:-}"
  local attestation_file
  attestation_file="$(mktemp)"
  trap "rm -f '$attestation_file'" RETURN

  local curl_opts=(--fail --location --retry 4 --retry-delay 2
    --connect-timeout 5 --max-time 20 --max-filesize 1048576
    --silent --show-error)

  curl "${curl_opts[@]}" \
    -H "Accept: application/vnd.github+json" \
    -H "User-Agent: omakeys-installer" \
    "$ATTESTATIONS_API/sha256:$binary_sha256" \
    -o "$attestation_file" \
    || return 1

  local jq_filter
  if [[ -n "$expected_commit" && -n "$version" ]]; then
    jq_filter='.attestations
      | map(.bundle.dsseEnvelope.payload | @base64d | fromjson)
      | map(select(
          .predicateType == "https://slsa.dev/provenance/v1"
          and .predicate.buildDefinition.externalParameters.workflow.repository == "https://github.com/'"$REPO"'" 
          and .predicate.buildDefinition.externalParameters.workflow.ref == "refs/tags/'"$version"'" 
          and .subject[0].digest.sha256 == "'"$binary_sha256"'"
          and .predicate.buildDefinition.resolvedDependencies[0].digest.gitCommit == "'"$expected_commit"'"
        ))
      | length > 0'
  else
    jq_filter='.attestations
      | map(.bundle.dsseEnvelope.payload | @base64d | fromjson)
      | map(select(
          .predicateType == "https://slsa.dev/provenance/v1"
          and .predicate.buildDefinition.externalParameters.workflow.repository == "https://github.com/'"$REPO"'" 
          and .subject[0].digest.sha256 == "'"$binary_sha256"'"
        ))
      | length > 0'
  fi

  if ! jq -e "$jq_filter" "$attestation_file" >/dev/null 2>&1; then
    return 1
  fi

  if command -v gh >/dev/null 2>&1; then
    if gh attestation verify "$binary_path" --owner "${REPO%/*}" >/dev/null 2>&1; then
      echo "Build attestation verified (GitHub-signed provenance, Sigstore)"
      return 0
    fi
    if gh attestation verify "$binary_path" --repo "$REPO" >/dev/null 2>&1; then
      echo "Build attestation verified (GitHub-signed provenance, Sigstore)"
      return 0
    fi
    return 1
  fi

  if [[ -n "$expected_commit" ]]; then
    echo "error: gh is required for cryptographic attestation verification of pinned commit $expected_commit" >&2
    echo "Install gh (https://cli.github.com) or build locally with --build-install" >&2
    return 1
  fi

  echo "Build attestation verified (payload checks, install gh for full Sigstore verification)"
  return 0
}

fetch_release() {
  command -v jq  >/dev/null 2>&1 || fail "jq is required (omarchy pkg add jq)"
  command -v curl >/dev/null 2>&1 || fail "curl is required (omarchy pkg add curl)"

  if [[ "$(uname -m)" != "x86_64" ]]; then
    fail "no prebuilt daemon for $(uname -m); build it from source with --build (omarchy pkg add rust)"
  fi

  local version
  version="$(resolve_version)"
  local base="$RELEASES_URL/$version"
  asset_dir="$(mktemp -d)"

  local curl_opts=(--fail --location --retry 3 --retry-delay 2
    --connect-timeout 10 --max-time 60 --max-filesize 10485760
    --silent --show-error)

  curl "${curl_opts[@]}" "$base/$HELPER_ASSET"       -o "$asset_dir/$HELPER_ASSET" \
    || fail "could not download $HELPER_ASSET $version -- no release yet? Build from source with --build"

  local binary_sha256
  binary_sha256="$(sha256sum "$asset_dir/$HELPER_ASSET" | cut -d' ' -f1)"

  local expected_sha256=""
  local expected_commit=""
  if [[ "$version" == "$PINNED_VERSION" ]]; then
    expected_sha256="$PINNED_SHA256"
    expected_commit="$PINNED_COMMIT"
    if [[ -f "$PROJECT_DIR/bin/omakeys-daemon-$PINNED_VERSION.sha256" ]]; then
      local pinned_file_sha
      pinned_file_sha="$(cut -d' ' -f1 < "$PROJECT_DIR/bin/omakeys-daemon-$PINNED_VERSION.sha256" | tr -d '[:space:]')"
      if [[ -n "$pinned_file_sha" && "$pinned_file_sha" != "$PINNED_SHA256" ]]; then
        fail "pinned SHA mismatch between installer and checksum file"
      fi
    fi
    if [[ "$binary_sha256" != "$expected_sha256" ]]; then
      fail "checksum mismatch for $HELPER_ASSET $version: expected $expected_sha256, got $binary_sha256; refusing to install (tag may have been moved or asset replaced)"
    fi
  else
    curl "${curl_opts[@]}" "$base/$HELPER_ASSET.sha256" -o "$asset_dir/$HELPER_ASSET.sha256" \
      || fail "could not download checksum for $HELPER_ASSET $version"
    if ! (cd "$asset_dir" && sha256sum --check --status "$HELPER_ASSET.sha256"); then
      fail "checksum mismatch for $HELPER_ASSET $version; refusing to install it"
    fi
    if [[ "$binary_sha256" != "$(cut -d' ' -f1 < "$asset_dir/$HELPER_ASSET.sha256" | tr -d '[:space:]')" ]]; then
      fail "checksum mismatch for $HELPER_ASSET $version; refusing to install it"
    fi
  fi

  if ! verify_attestation "$asset_dir/$HELPER_ASSET" "$binary_sha256" "$expected_commit" "$version"; then
    fail "attestation verification failed for $HELPER_ASSET $version; refusing to install it.
  Check your network (the GitHub API rate-limits unauthenticated requests) and retry,
  or verify manually with: gh attestation verify $asset_dir/$HELPER_ASSET --owner ${REPO%/*}"
  fi

  run_as_root install -m 2755 -o root -g input "$asset_dir/$HELPER_ASSET" "$DAEMON"
  echo "OmaKeys daemon $version installed and setgid configured at $DAEMON"
}

build_daemon() {
  local mode="${1:-}"
  if ! command -v cargo >/dev/null 2>&1; then
    fail "cargo not found. Install Rust first or use --install for the prebuilt release binary."
  fi
  (
    cd "$PROJECT_DIR"
    cargo build --release --bin omakeys-daemon
  )
  local built="$PROJECT_DIR/target/release/omakeys-daemon"

  if [[ "$mode" == "setgid" ]]; then
    run_as_root install -m 2755 -o root -g input "$built" "$DAEMON"
    echo "daemon built and installed at $DAEMON (setgid root:input)"
  else
    cp "$built" "$DAEMON"
    chmod +x "$DAEMON"
    echo "daemon built and installed at $DAEMON (local permissions)"
  fi
}

add_to_input_group() {
  if id -nG | tr ' ' '\n' | grep -qx "input"; then
    echo "user is already in the input group"
    return 0
  fi
  run_as_root usermod -aG input "$(id -un)"
  echo "Membership is only active after the next login"
}

uninstall_daemon() {
  if [[ ! -e "$DAEMON" ]]; then
    echo "daemon: not installed; nothing to remove"
    return 0
  fi
  run_as_root rm -f "$DAEMON"
  echo "daemon removed"
}

do_check() {
  if [[ ! -x "$DAEMON" ]]; then
    echo "daemon: NOT installed; run with --install (release binary) or --build (local build)"
  else
    echo "daemon: present ($(stat -c '%s bytes' "$DAEMON"))"
  fi
  if [[ -g "$DAEMON" ]] && [[ "$(stat -c '%G' "$DAEMON")" == "input" ]]; then
    echo "setgid: active (group input, no re-login required)"
  else
    echo "setgid: NOT active; run --install once with sudo so evdev capture works"
  fi
}

case "${1:-}" in
  --check) do_check ;;
  --build) build_daemon ;;
  --build-install) build_daemon "setgid" ;;
  --install) fetch_release ;;
  --uninstall) uninstall_daemon ;;
  --usermod)
    fetch_release
    add_to_input_group
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *) usage ;;
esac
