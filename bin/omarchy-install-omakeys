#!/usr/bin/env bash
# omarchy:summary=Install the OmaKeys daemon (from the latest GitHub release or a local build) and grant input-group access (no re-login)
# omarchy:requires-sudo=true

set -euo pipefail

if (( EUID == 0 )); then
  export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
DAEMON="$SCRIPT_DIR/omakeys-daemon"
REPO="skvggor/omakeys-omarchy-plugin"
# Signer identity pinned during verification: only attestations whose Fulcio
# certificate carries this workflow URI are accepted (GitHub Actions OIDC).
SIGNER_WORKFLOW=".github/workflows/release.yml"
OIDC_ISSUER="https://token.actions.githubusercontent.com"
RELEASES_URL="https://github.com/$REPO/releases/download"
ATTESTATIONS_API="https://api.github.com/repos/$REPO/attestations"
HELPER_ASSET="omakeys-daemon-x86_64-linux-gnu"
# Supply-chain pin: an allowlist of immutable commits, not a reference to the
# tip. The signed provenance must name one of these exact SHAs, so a build from
# any other commit is rejected even when it is correctly signed and the owner
# controls the tag, the asset and the published checksum. Each entry earns its
# place:
#   e252db81  the source commit reviewed by the marketplace maintainer
#   3f714a1   the commit the published v1.0.0 asset was actually built from
# src/ is byte-identical across the two (e252db81 only touched QML and docs),
# so both resolve to the same daemon, and provenance is unforgeable, so neither
# entry can be quietly repointed at different code.
# Cutting a release takes a follow-up commit: the attestation names the tagged
# commit and a tree cannot contain its own SHA, so the release commit is added
# here in the next commit, together with the new pinned digest:
#   sha256sum omakeys-daemon-x86_64-linux-gnu > bin/omakeys-daemon-x86_64-linux-gnu.sha256
ACCEPTED_SOURCE_COMMITS=("e252db81ff26b7f58376897369e2f62306838258" "3f714a18085b6a71e892328c0a6923899a8f9028")
# Pinned digest of the release asset, in version control.
PINNED_SHA256_FILE="$PROJECT_DIR/bin/omakeys-daemon-x86_64-linux-gnu.sha256"
# Pinned Sigstore Fulcio CA chain: the trust anchor for the attestation certificate.
FULCIO_CHAIN_FILE="$PROJECT_DIR/bin/sigstore-fulcio-chain.pem"
asset_dir=""
verify_dir=""

fail() {
  echo "error: $*" >&2
  exit 1
}

cleanup() {
  [[ -n "$asset_dir" ]] && rm -rf "$asset_dir"
  [[ -n "$verify_dir" ]] && rm -rf "$verify_dir"
  return 0
}

trap cleanup EXIT

usage() {
  echo "Usage: $(basename "$0") [--check|--build|--build-install|--install|--uninstall|--usermod]" >&2
  echo "  --check          Report daemon readiness and setgid status" >&2
  echo "  --build          Compile the daemon locally with cargo (developers only, no sudo)" >&2
  echo "  --build-install  Compile locally and setgid it to group 'input' (developers, sudo)" >&2
  echo "  --install        Verify and download the daemon from the latest GitHub release, then setgid it (sudo, no Rust needed)" >&2
  echo "  --uninstall      Remove the setgid daemon binary (sudo)" >&2
  echo "  --usermod        Install from release and add the current user to the 'input' group (next login)" >&2
  echo "  -h, --help       Show this help" >&2
  echo "Environment:" >&2
  echo "  OMAKEYS_VERSION  Release tag to download, e.g. v1.0.0 (default: reads manifest.json)" >&2
  # omarchy:flag-requires-sudo=true
  exit 1
}

run_as_root() {
  local command_name="$1"
  shift
  if (( EUID == 0 )); then
    "$command_name" "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo "$command_name" "$@"
  elif command -v pkexec >/dev/null 2>&1; then
    pkexec "$command_name" "$@"
  else
    fail "need root (no sudo or pkexec available): $command_name $*"
  fi
}

resolve_version() {
  local version="${OMAKEYS_VERSION:-}"
  if [[ -z "$version" ]]; then
    if command -v jq >/dev/null 2>&1 && [[ -f "$PROJECT_DIR/manifest.json" ]]; then
      local parsed_version
      parsed_version="$(jq -r '.version // empty' "$PROJECT_DIR/manifest.json")"
      if [[ -n "$parsed_version" && "$parsed_version" != "null" ]]; then
        version="v$parsed_version"
      fi
    fi
  fi

  if [[ -z "$version" ]]; then
    version="$(curl --fail --silent --show-error --connect-timeout 10 \
      --max-time 20 --head \
      "https://github.com/$REPO/releases/latest" \
      | grep -i '^location:' \
      | sed -n 's/.*\/tag\/\(v[0-9a-zA-Z.-]*\).*/\1/p' \
      | tr -d '\r' \
      | head -n 1 || true)"
  fi

  [[ -n "$version" ]] || fail "could not resolve version (set OMAKEYS_VERSION or install jq)"
  echo "$version"
}

verify_attestation() {
  local binary_sha256="$1"

  # Fail closed: without openssl there is no way to check the DSSE signature or
  # the Fulcio certificate chain, so the prebuilt path must not reach the setgid
  # install.
  if ! command -v openssl >/dev/null 2>&1; then
    echo "error: openssl is required to verify the build attestation (omarchy pkg add openssl)" >&2
    return 1
  fi
  if [[ ! -f "$FULCIO_CHAIN_FILE" ]]; then
    echo "error: pinned Sigstore CA chain not found at $FULCIO_CHAIN_FILE" >&2
    return 1
  fi

  verify_dir="$(mktemp -d)" || return 1
  local api_file="$verify_dir/attestations.json"
  local bundle_file="$verify_dir/bundle.json"
  local payload_file="$verify_dir/payload.bin"
  local payload_type_file="$verify_dir/payload-type"
  local signature_file="$verify_dir/signature.bin"
  local certificate_der="$verify_dir/certificate.der"
  local certificate_pem="$verify_dir/certificate.pem"
  local public_key_file="$verify_dir/public-key.pem"
  local signed_message="$verify_dir/pae-space.bin"
  local colon_message="$verify_dir/pae-colon.bin"
  local empty_ca_dir="$verify_dir/empty-ca"

  local curl_opts=(--fail --location --retry 4 --retry-delay 2
    --connect-timeout 5 --max-time 20 --max-filesize 1048576
    --silent --show-error)

  curl "${curl_opts[@]}" \
    -H "Accept: application/vnd.github+json" \
    -H "User-Agent: omakeys-installer" \
    "$ATTESTATIONS_API/sha256:$binary_sha256" \
    -o "$api_file" \
    || return 1

  if ! jq -e '.attestations[0].bundle' "$api_file" >"$bundle_file" 2>/dev/null; then
    echo "error: no attestation bundle published for sha256:$binary_sha256" >&2
    return 1
  fi

  if ! jq -jer '.dsseEnvelope.payloadType' "$bundle_file" >"$payload_type_file" 2>/dev/null; then
    echo "error: attestation bundle carries no DSSE payload type" >&2
    return 1
  fi
  if ! jq -j '.dsseEnvelope.payload' "$bundle_file" 2>/dev/null | base64 -d >"$payload_file" 2>/dev/null; then
    echo "error: attestation payload is not valid base64" >&2
    return 1
  fi
  if ! jq -j '.dsseEnvelope.signatures[0].sig' "$bundle_file" 2>/dev/null | base64 -d >"$signature_file" 2>/dev/null; then
    echo "error: attestation signature is not valid base64" >&2
    return 1
  fi
  if ! jq -j '.verificationMaterial.certificate.rawBytes' "$bundle_file" 2>/dev/null | base64 -d >"$certificate_der" 2>/dev/null; then
    echo "error: attestation certificate is not valid base64" >&2
    return 1
  fi

  # The transparency-log timestamp dates the Fulcio certificate: the short-lived
  # signing certificate only chains back to the pinned CA at that instant.
  local integrated_time
  if ! integrated_time="$(jq -er '.verificationMaterial.tlogEntries[0].integratedTime' "$bundle_file" 2>/dev/null)" \
    || [[ ! "$integrated_time" =~ ^[0-9]+$ ]]; then
    echo "error: attestation bundle carries no usable transparency-log timestamp" >&2
    return 1
  fi

  if ! openssl x509 -inform der -in "$certificate_der" -out "$certificate_pem" 2>/dev/null; then
    echo "error: attestation certificate could not be parsed" >&2
    return 1
  fi

  mkdir -p "$empty_ca_dir" || return 1
  local chain_output
  if ! chain_output="$(openssl verify -attime "$integrated_time" \
        -CAfile "$FULCIO_CHAIN_FILE" -CApath "$empty_ca_dir" "$certificate_pem" 2>&1)"; then
    echo "error: attestation certificate does not chain to the pinned Sigstore CA:" >&2
    echo "$chain_output" >&2
    return 1
  fi

  local certificate_text
  if ! certificate_text="$(openssl x509 -in "$certificate_pem" -noout -text 2>/dev/null)"; then
    echo "error: attestation certificate could not be read" >&2
    return 1
  fi
  if ! grep -qF "URI:https://github.com/$REPO/$SIGNER_WORKFLOW@" <<<"$certificate_text"; then
    echo "error: attestation was not signed by $REPO/$SIGNER_WORKFLOW" >&2
    return 1
  fi
  if ! grep -qF "$OIDC_ISSUER" <<<"$certificate_text"; then
    echo "error: attestation certificate carries no GitHub Actions OIDC issuer" >&2
    return 1
  fi

  if ! openssl x509 -in "$certificate_pem" -pubkey -noout >"$public_key_file" 2>/dev/null; then
    echo "error: attestation public key could not be extracted" >&2
    return 1
  fi

  # Pre-Authentication Encoding of the DSSE envelope: "DSSEv1 <type length> <type>
  # <payload length> <payload>", the space separated form produced by
  # go-securesystemslib. The colon separated variant is accepted too, so bundles
  # from older signing stacks keep verifying.
  local payload_type_length payload_length
  payload_type_length="$(wc -c <"$payload_type_file" | tr -d '[:space:]')" || return 1
  payload_length="$(wc -c <"$payload_file" | tr -d '[:space:]')" || return 1
  {
    printf 'DSSEv1 %s %s %s ' "$payload_type_length" "$(cat "$payload_type_file")" "$payload_length"
    cat "$payload_file"
  } >"$signed_message" || return 1
  {
    printf 'DSSEv1%s:%s%s:' "$payload_type_length" "$(cat "$payload_type_file")" "$payload_length"
    cat "$payload_file"
  } >"$colon_message" || return 1

  if ! openssl dgst -sha256 -verify "$public_key_file" -signature "$signature_file" "$signed_message" >/dev/null 2>&1 \
    && ! openssl dgst -sha256 -verify "$public_key_file" -signature "$signature_file" "$colon_message" >/dev/null 2>&1; then
    echo "error: DSSE signature of the attestation payload does not verify" >&2
    return 1
  fi

  # The payload is authenticated now that its signature verified, so its claims
  # (predicate type, subject digest, repository, build type, source commit) can
  # be checked without trusting the transport.
  local expected_repo="https://github.com/$REPO"
  if ! jq -e --arg sha256 "$binary_sha256" --arg repo "$expected_repo" \
    --arg commit1 "${ACCEPTED_SOURCE_COMMITS[0]}" --arg commit2 "${ACCEPTED_SOURCE_COMMITS[1]}" '
    .dsseEnvelope.payload
    | @base64d | fromjson
    | select(.predicateType == "https://slsa.dev/provenance/v1")
    | select(.subject[0].digest.sha256 == $sha256)
    | select(.predicate.buildDefinition.externalParameters.workflow.repository == $repo)
    | select(.predicate.buildDefinition.buildType == "https://actions.github.io/buildtypes/workflow/v1")
    | select(
        .predicate.buildDefinition.resolvedDependencies[0].digest.gitCommit == $commit1
        or .predicate.buildDefinition.resolvedDependencies[0].digest.gitCommit == $commit2
      )
  ' "$bundle_file" >/dev/null 2>&1; then
    echo "error: attestation provenance does not match the pinned source commit" >&2
    return 1
  fi

  echo "Build attestation cryptographically verified (Sigstore bundle, signer $REPO/$SIGNER_WORKFLOW; provenance for $binary_sha256, source ${ACCEPTED_SOURCE_COMMITS[*]})" >&2
  return 0
}

fetch_release() {
  command -v jq  >/dev/null 2>&1 || fail "jq is required (omarchy pkg add jq)"
  command -v curl >/dev/null 2>&1 || fail "curl is required (omarchy pkg add curl)"

  if [[ "$(uname -m)" != "x86_64" ]]; then
    fail "no prebuilt daemon for $(uname -m); build it from source with --build (omarchy pkg add rust)"
  fi

  local version
  version="$(resolve_version)"
  local base="$RELEASES_URL/$version"
  asset_dir="$(mktemp -d)"

  local curl_opts=(--fail --location --retry 3 --retry-delay 2
    --connect-timeout 10 --max-time 60 --max-filesize 10485760
    --silent --show-error)

  curl "${curl_opts[@]}" "$base/$HELPER_ASSET" -o "$asset_dir/$HELPER_ASSET" \
    || fail "could not download $HELPER_ASSET $version -- no release yet? Build from source with --build"

  # Bind expected digest from version-controlled pin file; fail closed if tag was moved.
  local binary_sha256
  binary_sha256="$(sha256sum "$asset_dir/$HELPER_ASSET" | cut -d' ' -f1)"

  if [[ -f "$PINNED_SHA256_FILE" ]]; then
    local pinned_sha256
    pinned_sha256="$(awk '{print $1}' "$PINNED_SHA256_FILE" | head -n 1)"
    if [[ -z "$pinned_sha256" ]]; then
      fail "pinned digest file $PINNED_SHA256_FILE is empty; refusing to install"
    fi
    if [[ "$binary_sha256" != "$pinned_sha256" ]]; then
      fail "checksum mismatch for $HELPER_ASSET $version: expected $pinned_sha256 (from $PINNED_SHA256_FILE), got $binary_sha256; refusing to install (tag may have been moved)"
    fi
  else
    fail "pinned digest file $PINNED_SHA256_FILE not found in plugin tree; refusing to install (supply-chain pin missing)"
  fi

  if ! verify_attestation "$binary_sha256"; then
    fail "attestation verification failed for $HELPER_ASSET $version; refusing to install it.
  Check your network (the GitHub API rate-limits unauthenticated requests),
  install openssl when missing (omarchy pkg add openssl), or build from
  source with --build-install"
  fi

  run_as_root install -m 2755 -o root -g input "$asset_dir/$HELPER_ASSET" "$DAEMON"
  echo "OmaKeys daemon $version installed and setgid configured at $DAEMON"
}

build_daemon() {
  local mode="${1:-}"
  if ! command -v cargo >/dev/null 2>&1; then
    fail "cargo not found. Install Rust first or use --install for the prebuilt release binary."
  fi
  (
    cd "$PROJECT_DIR"
    cargo build --release --bin omakeys-daemon
  )
  local built="$PROJECT_DIR/target/release/omakeys-daemon"

  if [[ "$mode" == "setgid" ]]; then
    run_as_root install -m 2755 -o root -g input "$built" "$DAEMON"
    echo "daemon built and installed at $DAEMON (setgid root:input)"
  else
    cp "$built" "$DAEMON"
    chmod +x "$DAEMON"
    echo "daemon built and installed at $DAEMON (local permissions)"
  fi
}

add_to_input_group() {
  if id -nG | tr ' ' '\n' | grep -qx "input"; then
    echo "user is already in the input group"
    return 0
  fi
  run_as_root usermod -aG input "$(id -un)"
  echo "Membership is only active after the next login"
}

uninstall_daemon() {
  if [[ ! -e "$DAEMON" ]]; then
    echo "daemon: not installed; nothing to remove"
    return 0
  fi
  run_as_root rm -f "$DAEMON"
  echo "daemon removed"
}

do_check() {
  if [[ ! -x "$DAEMON" ]]; then
    echo "daemon: NOT installed; run with --install (release binary) or --build (local build)"
  else
    echo "daemon: present ($(stat -c '%s bytes' "$DAEMON"))"
  fi
  if [[ -g "$DAEMON" ]] && [[ "$(stat -c '%G' "$DAEMON")" == "input" ]]; then
    echo "setgid: active (group input, no re-login required)"
  else
    echo "setgid: NOT active; run --install once with sudo so evdev capture works"
  fi
}

case "${1:-}" in
  --check) do_check ;;
  --build) build_daemon ;;
  --build-install) build_daemon "setgid" ;;
  --install) fetch_release ;;
  --uninstall) uninstall_daemon ;;
  --usermod)
    fetch_release
    add_to_input_group
    ;;
  -h | --help) usage ;;
  *) usage ;;
esac
